namespace materials_project {

    entity SummaryDoc {
        id: string @unique
        material_id: string
        formula_pretty: string
        formula_anonymous: string
        chemsys: string
        volume: float
        density: float
        density_atomic: float
        nsites: integer
        nelements: integer
        theoretical: boolean
        deprecated: boolean
        is_stable: boolean
        is_magnetic: boolean
        is_metal: boolean
        is_gap_direct: boolean
        band_gap: float
        efermi: float
        formation_energy_per_atom: float
        energy_above_hull: float
        uncorrected_energy_per_atom: float
        energy_per_atom: float
        equilibrium_reaction_energy_per_atom: float
        total_magnetization: float
        total_magnetization_normalized_vol: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity MaterialsDoc {
        id: string @unique
        material_id: string
        formula_pretty: string
        formula_anonymous: string
        chemsys: string
        volume: float
        density: float
        density_atomic: float
        nsites: integer
        nelements: integer
        last_updated: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity ThermoDoc {
        id: string @unique
        material_id: string
        thermo_type: string
        energy_type: string
        uncorrected_energy_per_atom: float
        energy_per_atom: float
        formation_energy_per_atom: float
        energy_above_hull: float
        is_stable: boolean
        equilibrium_reaction_energy_per_atom: float
        decomposition_enthalpy: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity CoreTaskDoc {
        id: string @unique
        task_id: string
        task_type: string
        run_type: string
        calc_type: string
        batch_id: string
        dir_name: string
        vasp_version: string
        completed_at: datetime
        last_updated: datetime
        nsites: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ElectronicStructureDoc {
        id: string @unique
        material_id: string
        band_gap: float
        cbm: float
        vbm: float
        efermi: float
        is_gap_direct: boolean
        is_metal: boolean
        magnetic_ordering: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity MagnetismDoc {
        id: string @unique
        material_id: string
        ordering: string
        is_magnetic: boolean
        total_magnetization: float
        total_magnetization_normalized_vol: float
        total_magnetization_normalized_formula_units: float
        num_magnetic_sites: integer
        num_unique_magnetic_sites: integer
        exchange_symmetry: integer
        createdAt: datetime
        updatedAt: datetime
    }

}
